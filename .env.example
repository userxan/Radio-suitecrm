SUITECRM_VERSION=8.10.1
# SuiteCRM site URL: e.g. http://<your-server-public-ip> or http://crm.yourstation.com
# Leave empty to automatically detect public host IP
SUITECRM_SITE_URL=
SUITECRM_ADMIN_USER=admin
SUITECRM_ADMIN_PASS=admin
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=suitecrm_db
DB_USER=suitecrm_user
DB_PASS=ChangeMe_DB_Pass!
DB_ROOT_PASS=ChangeMe_Root_Pass!
TZ=Africa/Johannesburg

# Login rate limiting thresholds
LOGIN_THROTTLING_MAX_ATTEMPTS=100
LOGIN_THROTTLING_IP_LOGIN_MAX_ATTEMPTS=500
LOGIN_THROTTLING_INTERVAL="1 minute"
